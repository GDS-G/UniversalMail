# Replace placeholders locally; never commit real credentials.
UNIVERSALMAIL_MASTER_KEY=replace-with-generated-Fernet-key
UNIVERSALMAIL_API_KEY=replace-with-random-key-at-least-32-characters
UNIVERSALMAIL_DB_PATH=./data/accounts.db
# Use this exact hostname when opening /connect and registering callback URIs.
UNIVERSALMAIL_PUBLIC_URL=http://localhost:8000
UNIVERSALMAIL_ALLOW_INSECURE_LOCALHOST=true
UNIVERSALMAIL_ALLOW_PRIVATE_MAIL_HOSTS=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
